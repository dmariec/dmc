<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --cream:#F9F6F1;
  --navy:#0F2444;
  --slate:#0F2444;
  --muted:#7A93B0;
  --accent:#B5895A;
  --line:#D6E2EF;
}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--cream);color:var(--navy);overflow-x:hidden;}

/* ── Nav ── */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:space-between;align-items:center;padding:24px 60px;background:rgba(249,246,241,0.95);backdrop-filter:blur(10px);border-bottom:1px solid transparent;transition:border-color 0.3s;}
nav.scrolled{border-color:var(--line);}
.nav-logo{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:500;color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:10px;}
.dc-mark{width:40px;height:40px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.dc-mark img{width:40px;height:40px;object-fit:contain;display:block;}
.nav-links{display:flex;gap:40px;list-style:none;}
.nav-links a{font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:var(--slate);text-decoration:none;transition:color 0.2s;}
.nav-links a:hover{color:var(--accent);}

/* ── Hero ── */
.hero{min-height:100vh;display:flex;align-items:center;padding:120px 60px 80px;}
.hero-inner{max-width:1100px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;}
.hero-eyebrow{font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:var(--accent);margin-bottom:20px;opacity:0;animation:fadeUp 0.8s ease forwards 0.2s;}
.hero-title{font-family:'Cormorant Garamond',serif;font-size:clamp(48px,6vw,76px);font-weight:300;line-height:1.1;color:var(--navy);opacity:0;animation:fadeUp 0.8s ease forwards 0.4s;}
/* FIX 1: <em> was unclosed in original — CSS intact, tag is now properly closed in HTML */
.hero-title em{font-style:italic;color:var(--accent);}
.hero-sub{margin-top:28px;font-size:16px;line-height:1.8;color:var(--slate);font-weight:300;max-width:420px;opacity:0;animation:fadeUp 0.8s ease forwards 0.6s;}
.hero-cta{margin-top:44px;display:flex;gap:20px;align-items:center;opacity:0;animation:fadeUp 0.8s ease forwards 0.8s;}
.btn-primary{display:inline-block;padding:14px 36px;background:var(--navy);color:var(--cream);font-size:13px;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;transition:background 0.2s;}
.btn-primary:hover{background:var(--accent);}
.btn-ghost{font-size:13px;letter-spacing:0.1em;text-transform:uppercase;color:var(--slate);text-decoration:none;border-bottom:1px solid var(--muted);padding-bottom:2px;transition:color 0.2s;}
.btn-ghost:hover{color:var(--accent);}
.hero-visual{opacity:0;animation:fadeIn 1.2s ease forwards 0.6s;}
.hero-card{background:white;border:1px solid var(--line);padding:48px;position:relative;}
.hero-card::before{content:'';position:absolute;top:12px;right:-12px;bottom:-12px;left:12px;border:1px solid var(--line);z-index:-1;}
.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;}
.stat-item{border-left:2px solid var(--accent);padding-left:16px;}
.stat-number{font-family:'Cormorant Garamond',serif;font-size:42px;font-weight:300;color:var(--navy);line-height:1;}
.stat-label{font-size:12px;color:var(--muted);letter-spacing:0.08em;text-transform:uppercase;margin-top:6px;}
.card-divider{border:none;border-top:1px solid var(--line);margin:36px 0;}
.card-tagline{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:400;font-style:italic;color:var(--slate);line-height:1.5;}

/* ── Sections ── */
section{padding:100px 60px;}
.section-inner{max-width:1100px;margin:0 auto;}
.section-label{font-size:11px;letter-spacing:0.25em;text-transform:uppercase;color:var(--accent);margin-bottom:16px;}
.section-title{font-family:'Cormorant Garamond',serif;font-size:clamp(34px,4vw,50px);font-weight:300;line-height:1.2;color:var(--navy);}

/* ── About ── */
#about{background:white;}
.about-grid{display:grid;grid-template-columns:1fr 1.4fr;gap:80px;align-items:start;margin-top:60px;}
.about-line{width:48px;height:2px;background:var(--accent);margin:24px 0;}
.about-text{font-size:16px;line-height:1.85;color:var(--slate);font-weight:300;margin-top:16px;}
.pillars{display:flex;flex-direction:column;gap:24px;}
.pillar{padding:28px 32px;border:1px solid var(--line);display:flex;gap:24px;align-items:flex-start;transition:border-color 0.3s;}
.pillar:hover{border-color:var(--accent);}
.pillar-icon{font-size:26px;flex-shrink:0;}
.pillar-title{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:500;color:var(--navy);margin-bottom:6px;}
.pillar-desc{font-size:14px;color:var(--muted);line-height:1.7;}

/* ── Services ── */
#services{background:var(--cream);}

/* FIX 6 & 7: Unified services grid — single wrapper, border on individual cards for clean mobile collapse */
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:60px;border:1px solid var(--line);}
.service-card{background:white;padding:48px 36px;transition:background 0.3s;border-right:1px solid var(--line);border-bottom:1px solid var(--line);}
/* Remove double right-border on last card per visual row */
.service-card:nth-child(3n){border-right:none;}
/* Remove bottom border on last row (cards 4-6) */
.service-card:nth-child(n+4){border-bottom:none;}

.service-card:hover{background:var(--navy);}
.service-card:hover .svc-num,.service-card:hover .svc-title,.service-card:hover .svc-desc{color:var(--cream);}
.service-card:hover .svc-tag{color:var(--cream);border-color:rgba(255,255,255,0.2);}
.svc-num{font-family:'Cormorant Garamond',serif;font-size:13px;color:var(--accent);letter-spacing:0.15em;margin-bottom:36px;transition:color 0.3s;}
.svc-title{font-family:'Cormorant Garamond',serif;font-size:24px;font-weight:400;color:var(--navy);line-height:1.3;margin-bottom:16px;transition:color 0.3s;}
.svc-desc{font-size:14px;line-height:1.75;color:var(--muted);margin-bottom:28px;transition:color 0.3s;}
.svc-tags{display:flex;flex-wrap:wrap;gap:8px;}
.svc-tag{font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--slate);border:1px solid var(--line);padding:4px 10px;transition:color 0.3s,border-color 0.3s;}

/* ── Process ── */
#process{background:var(--navy);}
#process .section-title{color:var(--cream);}
.process-steps{display:grid;grid-template-columns:repeat(4,1fr);margin-top:60px;border-top:1px solid rgba(255,255,255,0.1);}
.process-step{padding:40px 36px 40px 0;border-right:1px solid rgba(255,255,255,0.1);}
.process-step:last-child{border-right:none;padding-left:36px;padding-right:0;}
.process-step:not(:first-child):not(:last-child){padding-left:36px;}
.step-num{font-family:'Cormorant Garamond',serif;font-size:52px;font-weight:300;color:rgba(181,137,90,0.3);line-height:1;margin-bottom:20px;}
.step-title{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;color:var(--cream);margin-bottom:12px;}
.step-desc{font-size:13px;line-height:1.8;color:rgba(249,246,241,0.5);}

/* ── Contact ── */
#contact{background:white;}
.contact-intro{font-size:16px;line-height:1.85;color:var(--slate);font-weight:300;margin-top:24px;max-width:540px;}
.contact-detail{display:flex;align-items:center;gap:16px;margin-top:36px;padding-top:36px;border-top:1px solid var(--line);max-width:540px;}
.contact-icon{width:42px;height:42px;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.contact-label{font-size:11px;letter-spacing:0.15em;text-transform:uppercase;color:var(--muted);margin-bottom:4px;}
.contact-value{font-size:15px;color:var(--navy);}
.contact-value a{color:var(--navy);text-decoration:none;}
.contact-value a:hover{color:var(--accent);}
.contact-buttons{display:flex;gap:16px;margin-top:40px;flex-wrap:wrap;}

/* ── Footer ── */
footer{background:var(--navy);padding:40px 60px;display:flex;justify-content:space-between;align-items:center;}
.footer-logo{font-family:'Cormorant Garamond',serif;font-size:18px;color:var(--cream);display:flex;align-items:center;gap:10px;}
.footer-logo .dc-mark img{filter:brightness(0) invert(1);opacity:0.85;}
.footer-copy{font-size:12px;color:rgba(249,246,241,0.35);}
.footer-links{display:flex;gap:28px;}
.footer-links a{font-size:12px;color:rgba(249,246,241,0.45);text-decoration:none;letter-spacing:0.08em;text-transform:uppercase;transition:color 0.2s;}
.footer-links a:hover{color:var(--accent);}

/* ── Animations ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px);}to{opacity:1;transform:translateY(0);}}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity 0.7s ease,transform 0.7s ease;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* ── Responsive ── */
@media(max-width:900px){
  nav{padding:20px 24px;}
  .nav-links{display:none;}
  section{padding:60px 24px;}
  .hero{padding:80px 24px 50px;min-height:unset;}
  .hero-inner{grid-template-columns:1fr;}
  .hero-visual{display:none;}
  .about-grid{grid-template-columns:1fr;gap:40px;}

  /* FIX 6 & 7 mobile: single column, each card has bottom border, no right border */
  .services-grid{grid-template-columns:1fr;border:none;}
  .service-card{border:none;border-bottom:1px solid var(--line) !important;padding:36px 24px;}
  .service-card:last-child{border-bottom:none !important;}

  .process-steps{grid-template-columns:1fr;border-top:none;}
  .process-step{border-right:none !important;border-top:1px solid rgba(255,255,255,0.1);padding:30px 0 !important;}
  .process-step:first-child{border-top:none;}
  footer{flex-direction:column;gap:16px;text-align:center;padding:30px 24px;}
  .footer-links{justify-content:center;flex-wrap:wrap;}
  .contact-buttons{flex-direction:column;}
  .contact-buttons a{text-align:center;}
}
</style>
</head>
